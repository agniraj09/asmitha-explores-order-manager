# ------------------------------------------------------------------
# Copy to ".env" (or set these as real environment variables on your
# hosting provider) and fill in the values from
# Supabase > Project Settings > Database > Connection pooling.
# NEVER commit the filled-in file.
# ------------------------------------------------------------------

# ============ LOCAL profile (local PostgreSQL) ====================
# Only needed if your local database differs from these defaults.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=asmitha_explores
LOCAL_DB_USER=postgres
LOCAL_DB_PASSWORD=postgres

# ============ PROD profile (Supabase PostgreSQL) ==================
# Values from Supabase > Project Settings > Database > Connection pooling
SPRING_PROFILES_ACTIVE=prod

# Connection pooling host, e.g. aws-0-ap-south-1.pooler.supabase.com
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# 6543 = transaction pooler (recommended), 5432 = session pooler / direct
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
# With the pooler the user is postgres.<project-ref>
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<your-database-password>

# Optional
PORT=8080
DB_POOL_SIZE=5
DB_DDL_AUTO=update

# ============ Automatic delivery detection ========================
# Shipped orders are looked up with the courier and move to DELIVERED on
# their own. Set to false to only ever check from the order page button.
TRACKING_AUTO_SYNC=true
# How often the check runs and how long it waits after startup (milliseconds)
# 21600000 ms = every 6 hours
TRACKING_SYNC_INTERVAL_MS=21600000
TRACKING_SYNC_INITIAL_DELAY_MS=120000
